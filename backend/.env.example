# Backend runtime
BACKEND_PORT=3001

# Optional Surf Studio runtime/admin token for protected SDK runtime endpoints.
# SlabScout itself does not send this upstream.
SURF_API_KEY=local-dev-admin-token

# Renaiss OS Index API proxy configuration.
# Do not put real keys in git; configure these in Surf Studio deployment env vars.
RENAISS_API_BASE_URL=https://api.renaissos.com
RENAISS_API_KEY=rk_your_key_here
RENAISS_API_SECRET=rsk_your_secret_here
RENAISS_API_TIMEOUT_MS=15000
