# Required by Surf Studio backend runtime
BACKEND_PORT=3001

# Optional: Surf admin/runtime token for protected SDK routes.
# SURF_API_KEY=sk_...

# Renaiss OS Index API credentials stay server-side only.
# Never expose these as VITE_ variables and never commit real values.
RENAISS_API_BASE_URL=https://api.renaissos.com
RENAISS_API_KEY=rk_replace_me
RENAISS_API_SECRET=rsk_replace_me

# replay = deterministic demo fixtures; live = call Renaiss. Non-cert live failures enter REPLAY_FALLBACK and cannot pay/reserve.
SLABSCOUT_DEFAULT_MODE=replay

# Demo economics. Do not raise above Arc Track caps.
MARKET_PROOF_PRICE_USDC=0.001
# Required in live mode; must not be the built-in demo fallback.
MARKET_PROOF_SIGNING_SECRET=replace-with-a-local-demo-secret
POLICY_PROOF_SIGNING_SECRET=replace-with-a-local-policy-proof-secret

# Required before any live /api/scout/run call; send as x-slabscout-operator-token.
SLABSCOUT_OPERATOR_TOKEN=replace-with-runtime-operator-token

# Required for live budget/idempotency persistence. Use a deployment secret/path, not repo source.
# SLABSCOUT_STATE_FILE=/var/lib/slabscout/state.json

# mock is safe for demos. live adapters intentionally require explicit Circle/Arc envs and fail closed if missing.
CIRCLE_MODE=mock
# Live Circle/x402 placeholders; configure only on server/deployment secrets.
# CIRCLE_API_KEY=replace-at-runtime
# CIRCLE_AGENT_WALLET_ADDRESS=0xA9E0000000000000000000000000000000000001
# MARKET_PROOF_SERVICE_URL=https://your-x402-marketproof-service.example/prove
# MARKET_PROOF_PAYEE=slabscout-market-proof-service

ARC_EXECUTION_MODE=mock
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Required only for live Arc wallet execution; keep unset in mock/replay or set a real non-zero contract address.
# RESERVATION_ESCROW_ADDRESS=0xE500000000000000000000000000000000000001
AGENT_WALLET_ADDRESS=0xA9E0000000000000000000000000000000000001
SELLER_WALLET_ADDRESS=0x5000000000000000000000000000000000000001
